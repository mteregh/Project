<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Categories</h1>
    
    <% if can? :create, Category %>
      <%= link_to "New Category", new_category_path, class: "btn btn-primary" %>
    <% end %>
  </div>

  <div class="list-group">
    <% @categories.each do |category| %>
      <div class="list-group-item d-flex justify-content-between align-items-center">
        <%= link_to category.name, category, class: "text-decoration-none fs-5" %>
        
        <% if can? :manage, category %>
          <div class="d-flex">
            <%= link_to "Edit", edit_category_path(category), class: "btn btn-sm btn-outline-secondary me-2" %>
            <%= button_to "Delete", category, method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Are you sure?" } %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
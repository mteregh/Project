<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "EventHub" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      .bg-custom-dark { background-color: #1a1a2e !important; }
    </style>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
      <div class="container">
        <%= link_to "EventHub", root_path, class: "navbar-brand fw-bold" %>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto align-items-center">

            <li class="nav-item">
              <%= link_to "Events", events_path, class: "nav-link px-3" %>
            </li>

            <li class="nav-item">
              <%= link_to "Categories", categories_path, class: "nav-link px-3" %>
            </li>

            <li class="nav-item">
              <%= link_to "Venues", venues_path, class: "nav-link px-3" %>
            </li>

            <% if user_signed_in? %>
              <% if current_user.admin? %>
                <li class="nav-item">
                  <%= link_to "Users", users_path, class: "nav-link px-3" %>
                </li>
              <% end %>

              <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                <span class="nav-link text-light">
                  Hello, <%= current_user.name.presence || current_user.email %>
                </span>
              </li>

              <li class="nav-item mt-2 mt-lg-0">
                <%= link_to "Edit Profile", edit_user_registration_path, class: "nav-link text-light px-3" %>
              </li>

              <li class="nav-item mt-2 mt-lg-0">
                <%= button_to "Log out", destroy_user_session_path,
                    method: :delete,
                    class: "btn btn-outline-light px-4" %>
              </li>
            <% else %>
              <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                <%= link_to "Log in", new_user_session_path, class: "nav-link btn btn-outline-light px-4" %>
              </li>

              <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                <%= link_to "Sign up", new_user_registration_path, class: "nav-link btn btn-light text-dark px-4 fw-semibold" %>
              </li>
            <% end %>

          </ul>
        </div>
      </div>
    </nav>

    <div class="container mt-3">
      <% if notice %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <% if alert %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
    </div>

    <%= yield %>

    <footer class="bg-custom-dark text-white text-center py-4 mt-5">
      <div class="container">
        <p class="mb-0">&copy; 2026 EventHub. Developed by Team [González, Guerra, Urzúa].</p>
        <p class="small text-muted mt-1">Web Technologies Course - Semester 202610</p>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
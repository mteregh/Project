<div class="container mt-4">
  <h1>Events</h1>

  <% if can? :create, Event %>
    <%= link_to "Create Event", new_event_path, class: "btn btn-primary mb-3"%>
  <% end %>

  <ul class="list-group">
    <% @events.each do |event| %>
      <li class="list-group-item">
        <%= link_to event.title, event_path(event) %>
      </li>
    <% end %>
  </ul>
</div>
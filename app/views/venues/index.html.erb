<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Venues</h1>
    
    <% if can? :create, Venue %>
      <%= link_to "New Venue", new_venue_path, class: "btn btn-primary" %>
    <% end %>
  </div>

  <div class="list-group">
    <% @venues.each do |venue| %>
      <div class="list-group-item d-flex justify-content-between align-items-center">
        <div>
          <%= link_to venue.name, venue, class: "text-decoration-none fs-5 fw-bold d-block" %>
          <small class="text-muted"><%= venue.location %> (Capacity: <%= venue.capacity %>)</small>
        </div>
        
        <% if can? :manage, venue %>
          <div class="d-flex">
            <%= link_to "Edit", edit_venue_path(venue), class: "btn btn-sm btn-outline-secondary me-2" %>
            <%= button_to "Delete", venue, method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Are you sure?" } %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
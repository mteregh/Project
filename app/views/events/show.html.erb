<div class="container mt-4">

  <div class="d-flex justify-content-between align-items-start mb-3">
    <h1><%= @event.title %></h1>
    <span class="badge fs-6
      <%= @event.draft? ? 'bg-secondary' :
          @event.published? ? 'bg-success' :
          @event.ongoing? ? 'bg-primary' :
          @event.completed? ? 'bg-dark' : 'bg-danger' %>">
      <%= @event.status.capitalize %>
    </span>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <p><strong>Category:</strong>
            <%= link_to @event.category.name, category_path(@event.category) %>
          </p>

          <p><strong>Venue:</strong>
            <%= link_to @event.venue.name, venue_path(@event.venue) %>
          </p>

          <p><strong>Organizer:</strong>
            <%= link_to @event.user.name, user_path(@event.user) %>
          </p>
        </div>

        <div class="col-md-6">
          <p><strong>Start:</strong> <%= @event.start_date.strftime("%d/%m/%Y %H:%M") %></p>
          <p><strong>End:</strong> <%= @event.end_date.strftime("%d/%m/%Y %H:%M") %></p>
          <p><strong>Capacity:</strong>
            <%= @registrations_count %> / <%= @event.max_attendees %> registered
            <% if @available_spots > 0 %>
              <span class="text-success">(<%= @available_spots %> available)</span>
            <% else %>
              <span class="text-danger">(Full)</span>
            <% end %>
          </p>
        </div>
      </div>

      <hr>
      <h5>Description</h5>
      <%= @event.description %>
    </div>
  </div>

  <% if user_signed_in? && (can?(:update, @event) || can?(:publish, @event) || can?(:cancel, @event)) %>
    <div class="mb-4 d-flex gap-2 flex-wrap">
      <% if can? :update, @event %>
        <%= link_to "Edit", edit_event_path(@event), class: "btn btn-secondary" %>
      <% end %>

      <% if @event.draft? && can?(:publish, @event) %>
        <%= button_to "Publish", publish_event_path(@event),
            method: :patch,
            class: "btn btn-success" %>
      <% end %>

      <% if can? :cancel, @event %>
        <%= button_to "Cancel Event", cancel_event_path(@event),
            method: :patch,
            class: "btn btn-danger",
            data: { turbo_confirm: "Are you sure you want to cancel this event?" } %>
      <% end %>
    </div>
  <% end %>

  <% if user_signed_in? && @event.user_id != current_user.id %>
    <div class="mb-4">
      <% if @event.published? %>
        <% if @user_registration.nil? %>
          <% if can? :create, Registration %>
            <%= button_to "Register", event_registrations_path(@event),
                method: :post,
                class: "btn btn-primary" %>
          <% end %>

          <% if @event.full? %>
            <small class="text-muted ms-2">
              The event is full — you will be added to the waitlist.
            </small>
          <% end %>

        <% elsif @user_registration.confirmed? %>
          <span class="badge bg-success fs-6">✓ Registered</span>

          <% if can? :destroy, @user_registration %>
            <%= button_to "Cancel My Registration",
                event_registration_path(@event, @user_registration),
                method: :delete,
                class: "btn btn-outline-danger btn-sm ms-2",
                data: { turbo_confirm: "Are you sure you want to cancel your registration?" } %>
          <% end %>

        <% elsif @user_registration.waitlisted? %>
          <span class="badge bg-warning text-dark fs-6">⏳ Waitlisted</span>

          <% if can? :destroy, @user_registration %>
            <%= button_to "Leave Waitlist",
                event_registration_path(@event, @user_registration),
                method: :delete,
                class: "btn btn-outline-secondary btn-sm ms-2" %>
          <% end %>
        <% end %>

      <% elsif @event.draft? %>
        <span class="text-muted">This event has not been published yet.</span>
      <% elsif @event.ongoing? %>
        <span class="text-muted">This event is already in progress. New registrations are not accepted.</span>
      <% elsif @event.completed? %>
        <span class="text-muted">This event has already ended.</span>
      <% elsif @event.cancelled? %>
        <span class="text-danger">This event was cancelled.</span>
      <% end %>
    </div>
  <% end %>

  <h3 class="mt-4">Reviews</h3>

  <% if user_signed_in? && @event.status == "completed" %>
    <% if @event.registrations.exists?(user: current_user, status: "confirmed") %>
      <div class="card mb-4 shadow-sm border-0 bg-light">
        <div class="card-body">
          <h5 class="card-title">Leave a Review</h5>
        
          <%= form_with(model: [@event, Review.new], local: true) do |f| %>
            <div class="mb-3">
              <%= f.label :rating, "Rating (1 to 5)", class: "form-label fw-bold" %>
              <%= f.number_field :rating, in: 1..5, class: "form-control", required: true, style: "max-width: 100px;" %>
            </div>
            <div class="mb-3">
              <%= f.label :comment, "Your comment", class: "form-label fw-bold" %>
              <%= f.text_area :comment, rows: 3, class: "form-control", required: true, placeholder: "Tell us what you thought about the event..." %>
            </div>
            <%= f.submit "Submit Review", class: "btn btn-success" %>
          <% end %>
        </div>
      </div>
    <% else %>
      <p class="text-muted mb-4"><em>You can only review events you attended.</em></p>
    <% end %>
  <% elsif user_signed_in? && @event.status != "completed" %>
    <p class="text-muted mb-4"><em>Reviews will be enabled once the event is completed.</em></p>
  <% end %>

  <% if @reviews.any? %>
    <% @reviews.each do |review| %>
      <div class="card mb-2">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <strong><%= review.user.name %></strong>
            <span>
              <% review.rating.times do %>
                <span class="text-warning">★</span>
              <% end %>

              <% (5 - review.rating).times do %>
                <span class="text-muted">★</span>
              <% end %>
            </span>
          </div>

          <p class="mb-0 mt-1"><%= review.comment %></p>

          <% if user_signed_in? && can?(:destroy, review) %>
            <%= button_to "Delete", event_review_path(@event, review),
                method: :delete,
                class: "btn btn-sm btn-outline-danger mt-2",
                data: { turbo_confirm: "Delete this review?" } %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <p class="text-muted">There are no reviews for this event yet.</p>
  <% end %>

  <% if user_signed_in? && @event.completed? %>
    <% confirmed = @event.registrations.exists?(user_id: current_user.id, status: "confirmed") %>
    <% already_reviewed = @event.reviews.exists?(user_id: current_user.id) %>

    <% if confirmed && !already_reviewed && can?(:create, Review) %>
      <div class="card mt-3">
        <div class="card-body">
          <h5 class="card-title">Leave a Review</h5>

          <%= form_with url: event_reviews_path(@event), method: :post do |f| %>
            <div class="mb-3">
              <%= f.label :rating, "Rating (1–5)" %>
              <%= f.number_field :rating,
                  min: 1,
                  max: 5,
                  required: true,
                  class: "form-control",
                  placeholder: "e.g. 4" %>
            </div>

            <div class="mb-3">
              <%= f.label :comment, "Comment" %>
              <%= f.text_area :comment,
                  required: true,
                  class: "form-control",
                  rows: 3,
                  placeholder: "Tell us about your experience..." %>
            </div>

            <%= f.submit "Submit Review", class: "btn btn-primary" %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <div class="mt-4">
    <%= link_to "← Back to Events", events_path, class: "btn btn-outline-secondary" %>
  </div>

</div>